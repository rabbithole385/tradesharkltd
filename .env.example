# ---------- Required on Railway ----------
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=you@yourdomain.com
APP_URL=https://trshark.online

# ---------- Email ----------
# Just set RESEND_API_KEY. The site reads the domains verified in your Resend account and sends from
# no-reply@<your verified domain> automatically (re-checks every 10 min until DNS verification completes).
RESEND_API_KEY=
# Optional: force a specific sender (must be on a verified Resend domain)
# MAIL_FROM_ADDRESS=no-reply@trshark.online
MAIL_FROM_NAME=TradeShark
SUPPORT_EMAIL=support@trshark.online
# Optional backups, used only if Resend fails: BREVO_API_KEY=  or SMTP_HOST/SMTP_USER/SMTP_PASS

# ---------- Login security ----------
LOGIN_OTP=true              # email a 6-digit code on every client login
OTP_TTL_MINUTES=10
MAX_FAILED_LOGINS=5         # wrong passwords before the account is locked
LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_LOGIN_ALERTS=false

# ---------- Optional ----------
APP_NAME=TradeShark
GEMINI_API_KEY=
LIVE_CHAT_SCRIPT_URL=
